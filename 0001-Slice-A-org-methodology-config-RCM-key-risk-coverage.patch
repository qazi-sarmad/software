diff --git a/src/components/plan/MethodologyPanel.tsx b/src/components/plan/MethodologyPanel.tsx
new file mode 100644
index 0000000..25d20fb
--- /dev/null
+++ b/src/components/plan/MethodologyPanel.tsx
@@ -0,0 +1,77 @@
+import React, { useState } from 'react';
+import { useApp } from '../../context/AppContext';
+import { SAMPLING_LABELS } from '../../lib/methodology';
+import { OrgMethodologyConfig, SamplingMethodId } from '../../types';
+
+const ROLES = ['cia', 'audit_manager', 'reviewer', 'org_admin'];
+const toggle = <T,>(arr: T[], v: T) => (arr.includes(v) ? arr.filter((x) => x !== v) : [...arr, v]);
+
+export const MethodologyPanel: React.FC = () => {
+  const { currentUser, orgMethodology, saveOrgMethodology } = useApp();
+  const [open, setOpen] = useState(false);
+  const [cfg, setCfg] = useState<OrgMethodologyConfig>(orgMethodology);
+  const [errors, setErrors] = useState<string[]>([]);
+  const [saved, setSaved] = useState(false);
+  if (currentUser.role !== 'cia' && currentUser.role !== 'org_admin') return null;
+
+  const s = cfg.sampling;
+  const setS = (patch: Partial<typeof s>) => setCfg({ ...cfg, sampling: { ...s, ...patch } });
+  const num = (label: string, key: 'tolerableDeviationRate' | 'expectedDeviationRate' | 'minHighValue' | 'minLowValue' | 'minHaphazard') => (
+    <label className="text-apple-12 text-secondary flex flex-col gap-0.5">{label}
+      <input type="number" step="any" value={s[key]} onChange={(e) => setS({ [key]: Number(e.target.value) })}
+        className="border border-hairline rounded px-2 py-1 bg-surface text-primary" />
+    </label>
+  );
+
+  return (
+    <div className="border border-hairline rounded bg-surface">
+      <button className="w-full text-left px-4 py-2 text-apple-13 font-semibold text-primary" onClick={() => setOpen(!open)}>
+        Methodology {open ? '▾' : '▸'}
+      </button>
+      {open && (
+        <div className="p-4 space-y-4 border-t border-hairline">
+          <fieldset className="flex gap-4 text-apple-12">
+            <legend className="font-semibold text-primary">DEA/OET</legend>
+            {(['separate', 'consolidated'] as const).map((m) => (
+              <label key={m}><input type="radio" name="deaOet" checked={cfg.deaOetMode === m} onChange={() => setCfg({ ...cfg, deaOetMode: m })} /> {m}</label>
+            ))}
+          </fieldset>
+          <fieldset className="flex flex-wrap gap-3 text-apple-12">
+            <legend className="font-semibold text-primary">Allowed sampling methods</legend>
+            {(Object.keys(SAMPLING_LABELS) as SamplingMethodId[]).map((m) => (
+              <label key={m}><input type="checkbox" checked={s.allowedMethods.includes(m)} onChange={() => setS({ allowedMethods: toggle(s.allowedMethods, m) })} /> {SAMPLING_LABELS[m]}</label>
+            ))}
+          </fieldset>
+          <label className="text-apple-12 text-secondary flex flex-col gap-0.5 max-w-xs">Default method
+            <select value={s.defaultMethod} onChange={(e) => setS({ defaultMethod: e.target.value as SamplingMethodId })} className="border border-hairline rounded px-2 py-1 bg-surface text-primary">
+              {(Object.keys(SAMPLING_LABELS) as SamplingMethodId[]).map((m) => <option key={m} value={m}>{SAMPLING_LABELS[m]}</option>)}
+            </select>
+          </label>
+          <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
+            {num('Tolerable dev. rate', 'tolerableDeviationRate')}
+            {num('Expected dev. rate', 'expectedDeviationRate')}
+            {num('Min high-value', 'minHighValue')}
+            {num('Min low-value', 'minLowValue')}
+            {num('Min haphazard', 'minHaphazard')}
+          </div>
+          <p className="text-apple-11 text-tertiary">Z-score fixed at {s.zScore} (not editable per workpaper).</p>
+          <fieldset className="space-y-2 text-apple-12">
+            <legend className="font-semibold text-primary">Deploy policy</legend>
+            <div className="flex flex-wrap gap-3">Can request:
+              {ROLES.map((r) => <label key={r}><input type="checkbox" checked={cfg.deploy.canRequestDeployRoleIds.includes(r)} onChange={() => setCfg({ ...cfg, deploy: { ...cfg.deploy, canRequestDeployRoleIds: toggle(cfg.deploy.canRequestDeployRoleIds, r) } })} /> {r}</label>)}
+            </div>
+            <label><input type="checkbox" checked={cfg.deploy.requiresApproval} onChange={() => setCfg({ ...cfg, deploy: { ...cfg.deploy, requiresApproval: !cfg.deploy.requiresApproval } })} /> Requires approval</label>
+            {cfg.deploy.requiresApproval && (
+              <div className="flex flex-wrap gap-3">Can approve:
+                {ROLES.map((r) => <label key={r}><input type="checkbox" checked={cfg.deploy.canApproveDeployRoleIds.includes(r)} onChange={() => setCfg({ ...cfg, deploy: { ...cfg.deploy, canApproveDeployRoleIds: toggle(cfg.deploy.canApproveDeployRoleIds, r) } })} /> {r}</label>)}
+              </div>
+            )}
+          </fieldset>
+          {errors.length > 0 && <ul role="alert" className="text-apple-12 text-amber list-disc pl-5">{errors.map((e) => <li key={e}>{e}</li>)}</ul>}
+          <button className="text-apple-12 font-semibold border border-hairline rounded px-3 py-1" onClick={() => { const r = saveOrgMethodology(cfg); setErrors(r.errors); setSaved(r.ok); }}>Save methodology</button>
+          {saved && <span className="ml-2 text-apple-12 text-verdigris">Saved</span>}
+        </div>
+      )}
+    </div>
+  );
+};
diff --git a/src/components/plan/PlanningCoveragePanel.tsx b/src/components/plan/PlanningCoveragePanel.tsx
