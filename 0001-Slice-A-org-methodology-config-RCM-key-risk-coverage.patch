@@ -0,0 +1,75 @@
+import type { PlanningRiskControlLink, PlanningRisk, AuditControl, WorkingPaper } from '../types';
+
+type WpLinks = Pick<WorkingPaper, 'id' | 'engagementId' | 'linkedRiskIds' | 'linkedControlIds'>;
+
+/**
+ * A key link is covered when at least one workpaper on the same engagement
+ * lists its controlId in linkedControlIds AND (if the link has a riskId)
+ * its riskId in linkedRiskIds.
+ */
+export function coverageGaps(
+  engagementId: string,
+  links: PlanningRiskControlLink[],
+  workpapers: WpLinks[],
+): { missing: PlanningRiskControlLink[] } {
+  const wps = workpapers.filter((w) => w.engagementId === engagementId);
+  const missing = links.filter((l) => {
+    if (l.engagementId !== engagementId || !l.isKey) return false;
+    return !wps.some(
+      (w) =>
+        (w.linkedControlIds ?? []).includes(l.controlId) &&
+        (!l.riskId || (w.linkedRiskIds ?? []).includes(l.riskId)),
+    );
+  });
+  return { missing };
+}
+
+export function gapLabel(
+  l: PlanningRiskControlLink,
+  risks: PlanningRisk[],
+  controls: Pick<AuditControl, 'id' | 'code' | 'title'>[],
+): string {
+  const risk = risks.find((r) => r.id === l.riskId)?.title ?? l.riskId;
+  const c = controls.find((x) => x.id === l.controlId);
+  return `${c ? `${c.code} ${c.title}` : l.controlId} (risk: ${risk})`;
+}
+
+/** Planning -> Testing gate. */
+export function canMoveToTesting(
+  engagementId: string,
+  links: PlanningRiskControlLink[],
+  workpapers: WpLinks[],
+  risks: PlanningRisk[],
+  controls: Pick<AuditControl, 'id' | 'code' | 'title'>[],
+): { allowed: boolean; reason?: string } {
+  const { missing } = coverageGaps(engagementId, links, workpapers);
+  if (missing.length === 0) return { allowed: true };
+  return {
+    allowed: false,
+    reason:
+      'Cannot move to testing. Key risks/controls without a workpaper: ' +
+      missing.map((m) => gapLabel(m, risks, controls)).join('; '),
+  };
+}
+
+/**
+ * WP pre-flight: warn if this WP links no key control while the engagement has key links.
+ * Hard when this WP is the only coverage vehicle (the only WP on the engagement).
+ */
+export function workpaperPreflight(
+  wp: WpLinks,
+  links: PlanningRiskControlLink[],
+  workpapers: WpLinks[],
+): { level: 'none' | 'soft' | 'hard'; message?: string } {
+  const key = links.filter((l) => l.engagementId === wp.engagementId && l.isKey);
+  if (key.length === 0) return { level: 'none' };
+  const keyControls = new Set(key.map((l) => l.controlId));
+  if ((wp.linkedControlIds ?? []).some((id) => keyControls.has(id))) return { level: 'none' };
+  const onlyWp = workpapers.filter((w) => w.engagementId === wp.engagementId).length <= 1;
+  return {
+    level: onlyWp ? 'hard' : 'soft',
+    message: onlyWp
+      ? 'This is the only workpaper on the engagement and it links no key control.'
+      : 'This workpaper links no key control, but the engagement has key controls to cover.',
+  };
+}
