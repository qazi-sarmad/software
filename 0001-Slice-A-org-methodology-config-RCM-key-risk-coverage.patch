+import type { OrgMethodologyConfig, SamplingMethodId, DeaOetMode, WorkpaperKind } from '../types';
+
+export const SAMPLING_LABELS: Record<SamplingMethodId, string> = {
+  random: 'Random', systematic: 'Systematic', stratified: 'Stratified', mus: 'MUS',
+  high_value: 'High-value', low_value: 'Low-value', haphazard: 'Haphazard',
+};
+
+export function validateMethodology(c: OrgMethodologyConfig): string[] {
+  const errs: string[] = [];
+  const s = c.sampling;
+  if (s.allowedMethods.length === 0) errs.push('Select at least one sampling method.');
+  if (!s.allowedMethods.includes(s.defaultMethod)) errs.push('Default method must be one of the allowed methods.');
+  for (const [k, v] of [['Tolerable deviation rate', s.tolerableDeviationRate], ['Expected deviation rate', s.expectedDeviationRate]] as const) {
+    if (!(v >= 0 && v <= 1)) errs.push(`${k} must be between 0 and 1.`);
+  }
+  if (s.expectedDeviationRate >= s.tolerableDeviationRate) errs.push('Expected deviation rate must be below tolerable rate.');
+  for (const [k, v] of [['High-value floor', s.minHighValue], ['Low-value floor', s.minLowValue], ['Haphazard floor', s.minHaphazard]] as const) {
+    if (!Number.isInteger(v) || v < 1) errs.push(`${k} must be a whole number of at least 1.`);
+  }
+  if (c.deploy.canRequestDeployRoleIds.length === 0) errs.push('Select at least one role that can request deployment.');
+  if (c.deploy.requiresApproval && c.deploy.canApproveDeployRoleIds.length === 0) errs.push('Select at least one approver role.');
+  return errs;
+}
+
+export function methodologySummary(c: OrgMethodologyConfig): string {
+  return `DEA/OET: ${c.deaOetMode} · Methods: ${c.sampling.allowedMethods.map((m) => SAMPLING_LABELS[m]).join(', ')}`;
+}
+
+/** Kinds a new WP may take under the org mode. */
+export function allowedWorkpaperKinds(mode: DeaOetMode): WorkpaperKind[] {
+  return mode === 'consolidated' ? ['consolidated'] : ['dea', 'oet'];
+}
+
+export function resolveWorkpaperKind(mode: DeaOetMode, requested?: WorkpaperKind): WorkpaperKind {
+  const ok = allowedWorkpaperKinds(mode);
+  return requested && ok.includes(requested) ? requested : ok[0];
+}
