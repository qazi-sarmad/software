+import { describe, it, expect } from 'vitest';
+import { validateMethodology, methodologySummary, resolveWorkpaperKind } from './methodology';
+import { initialOrgMethodology } from '../data/initialData';
+
+const clone = () => structuredClone(initialOrgMethodology);
+
+describe('methodology', () => {
+  it('seed config is valid', () => expect(validateMethodology(initialOrgMethodology)).toEqual([]));
+  it('rejects empty methods and default outside allowed', () => {
+    const c = clone(); c.sampling.allowedMethods = [];
+    expect(validateMethodology(c).length).toBeGreaterThan(0);
+    const d = clone(); d.sampling.allowedMethods = ['mus']; d.sampling.defaultMethod = 'random';
+    expect(validateMethodology(d)).toContain('Default method must be one of the allowed methods.');
+  });
+  it('rejects expected >= tolerable and missing approver', () => {
+    const c = clone(); c.sampling.expectedDeviationRate = 0.1;
+    expect(validateMethodology(c).join()).toContain('Expected deviation');
+    const d = clone(); d.deploy.canApproveDeployRoleIds = [];
+    expect(validateMethodology(d).join()).toContain('approver');
+  });
+  it('summary string', () => expect(methodologySummary(initialOrgMethodology)).toMatch(/^DEA\/OET: separate · Methods: Random/));
+  it('kind is always consolidated in consolidated mode', () => {
+    expect(resolveWorkpaperKind('consolidated', 'dea')).toBe('consolidated');
+    expect(resolveWorkpaperKind('separate', 'oet')).toBe('oet');
+    expect(resolveWorkpaperKind('separate')).toBe('dea');
+  });
+});
