+import { describe, it, expect } from 'vitest';
+import { coverageGaps, canMoveToTesting, workpaperPreflight } from './coverage';
+import type { PlanningRiskControlLink } from '../types';
+
+const L = (id: string, r: string, c: string, isKey = true): PlanningRiskControlLink =>
+  ({ id, engagementId: 'e1', riskId: r, controlId: c, isKey, source: 'rcm' });
+const links = [L('1', 'r1', 'c1'), L('2', 'r2', 'c2'), L('3', 'r3', 'c3', false)];
+const wp = (ids: { r?: string[]; c?: string[] }, eng = 'e1') =>
+  ({ id: 'w', engagementId: eng, linkedRiskIds: ids.r, linkedControlIds: ids.c });
+
+describe('coverageGaps', () => {
+  it('flags key links with no covering workpaper; ignores non-key', () => {
+    const g = coverageGaps('e1', links, [wp({ r: ['r1'], c: ['c1'] })]);
+    expect(g.missing.map((m) => m.id)).toEqual(['2']);
+  });
+  it('requires both control and risk on the same workpaper', () => {
+    const g = coverageGaps('e1', links, [wp({ r: ['r1'], c: ['c2'] }), wp({ r: ['r2'], c: ['c1'] })]);
+    expect(g.missing.map((m) => m.id)).toEqual(['1', '2']);
+  });
+  it('is covered when one WP links everything', () => {
+    expect(coverageGaps('e1', links, [wp({ r: ['r1', 'r2'], c: ['c1', 'c2'] })]).missing).toEqual([]);
+  });
+  it('ignores workpapers on other engagements', () => {
+    expect(coverageGaps('e1', links, [wp({ r: ['r1', 'r2'], c: ['c1', 'c2'] }, 'e2')]).missing).toHaveLength(2);
+  });
+});
+
+describe('canMoveToTesting', () => {
+  it('blocks with a message listing missing items', () => {
+    const r = canMoveToTesting('e1', links, [], [{ id: 'r1', title: 'Risk One' }], [{ id: 'c1', code: 'C-1', title: 'Ctl' }]);
+    expect(r.allowed).toBe(false);
+    expect(r.reason).toContain('C-1 Ctl');
+    expect(r.reason).toContain('Risk One');
+  });
+  it('allows when no gaps', () => {
+    expect(canMoveToTesting('e1', links, [wp({ r: ['r1', 'r2'], c: ['c1', 'c2'] })], [], []).allowed).toBe(true);
+  });
+});
+
+describe('workpaperPreflight', () => {
+  it('hard when the only WP links no key control', () => {
+    const w = wp({});
+    expect(workpaperPreflight(w, links, [w]).level).toBe('hard');
+  });
+  it('soft when other WPs exist', () => {
+    const w = wp({});
+    expect(workpaperPreflight(w, links, [w, wp({ c: ['c1'] })]).level).toBe('soft');
+  });
+  it('none when it links a key control or engagement has no key links', () => {
+    expect(workpaperPreflight(wp({ c: ['c1'] }), links, []).level).toBe('none');
+    expect(workpaperPreflight(wp({}), [L('9', 'r', 'c', false)], []).level).toBe('none');
+  });
+});
