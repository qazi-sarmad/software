+  const saveOrgMethodology = (cfg: OrgMethodologyConfig) => {
+    if (currentUser.role !== 'cia' && currentUser.role !== 'org_admin') {
+      return { ok: false, errors: ['Only the CIA or an Org Admin can change methodology.'] };
+    }
+    const errors = validateMethodology(cfg);
+    if (errors.length) return { ok: false, errors };
+    setOrgMethodology(cfg); // in-memory; Supabase persistence later
+    return { ok: true, errors: [] };
+  };
+
+  const advanceToTesting = (engagementId: string) => {
+    const eng = rawEngagements.find((e) => e.id === engagementId);
+    if (!eng || eng.stage !== 'planning') return { ok: false, reason: 'Engagement is not in planning.' };
+    if (eng.isLocked) return { ok: false, reason: 'Engagement is locked.' };
+    if (currentUser.role === 'observer' || currentUser.role === 'auditee') {
+      return { ok: false, reason: 'Your role cannot change the engagement stage.' };
+    }
+    const gate = canMoveToTesting(engagementId, planningLinks, rawWorkpapers, planningRisks, rawControls);
+    if (!gate.allowed) return { ok: false, reason: gate.reason };
+    setRawEngagements((prev) => prev.map((e) => (e.id === engagementId ? { ...e, stage: 'testing' } : e)));
+    return { ok: true };
+  };
+
+  const createWorkpaperForGap = (linkId: string, kind?: WorkpaperKind) => {
+    const link = planningLinks.find((l) => l.id === linkId);
+    const eng = link && rawEngagements.find((e) => e.id === link.engagementId);
+    const ctrl = link && rawControls.find((c) => c.id === link.controlId);
+    if (!link || !eng || !ctrl) return { ok: false, reason: 'Link, engagement or control not found.' };
+    if (eng.isLocked) return { ok: false, reason: 'Engagement is locked.' };
+    if (currentUser.role === 'observer' || currentUser.role === 'auditee') {
+      return { ok: false, reason: 'Your role cannot create workpapers.' };
+    }
+    const n = rawWorkpapers.filter((w) => w.engagementId === eng.id).length + 1;
+    const id = `wp-${eng.id}-${Date.now()}`;
+    const wp: WorkingPaper = {
+      id,
+      engagementId: eng.id,
+      controlId: ctrl.id,
+      entityId: eng.entityId,
+      universeId: eng.universeId,
+      refCode: `WP-${eng.id.toUpperCase()}-${n}`,
+      title: `${ctrl.code} ${ctrl.title}`,
+      status: 'not_started',
+      preparerId: eng.leadAuditorId,
+      reviewerId: eng.reviewerId,
+      kind: resolveWorkpaperKind(orgMethodology.deaOetMode, kind),
+      linkedRiskIds: [link.riskId],
+      linkedControlIds: [link.controlId],
+      testSteps: [],
+      populationCount: 0,
+      sampleCount: 0,
+      exceptionsIdentified: 0,
+      conclusion: '',
+      evidenceItems: [],
+    };
+    setRawWorkpapers((prev) => [...prev, wp]);
+    return { ok: true, workpaperId: id };
+  };
