+import React, { useState } from 'react';
+import { useApp } from '../../context/AppContext';
+import { coverageGaps, gapLabel } from '../../lib/coverage';
+import { allowedWorkpaperKinds } from '../../lib/methodology';
+import { WorkpaperKind } from '../../types';
+
+export const PlanningCoveragePanel: React.FC<{ engagementId: string; stage: string }> = ({ engagementId, stage }) => {
+  const { planningLinks, planningRisks, rawControls, rawWorkpapers, orgMethodology, createWorkpaperForGap, advanceToTesting } = useApp();
+  const [msg, setMsg] = useState<string | null>(null);
+  const [kind, setKind] = useState<WorkpaperKind>(allowedWorkpaperKinds(orgMethodology.deaOetMode)[0]);
+
+  const links = planningLinks.filter((l) => l.engagementId === engagementId);
+  if (links.length === 0 && stage !== 'planning') return null;
+  const { missing } = coverageGaps(engagementId, planningLinks, rawWorkpapers);
+  const kinds = allowedWorkpaperKinds(orgMethodology.deaOetMode);
+  const riskTitle = (id: string) => planningRisks.find((r) => r.id === id)?.title ?? id;
+  const ctrl = (id: string) => rawControls.find((c) => c.id === id);
+
+  return (
+    <div className="mt-3 p-3 rounded border border-hairline bg-surface-sunken space-y-2" onClick={(e) => e.stopPropagation()}>
+      <div className="flex items-center justify-between gap-2">
+        <span className="text-apple-12 font-semibold text-primary">Risk–control coverage</span>
+        {kinds.length > 1 && (
+          <select value={kind} onChange={(e) => setKind(e.target.value as WorkpaperKind)}
+            className="text-apple-11 border border-hairline rounded px-1 bg-surface" aria-label="New workpaper kind">
+            {kinds.map((k) => <option key={k} value={k}>{k.toUpperCase()}</option>)}
+          </select>
+        )}
+      </div>
+      {links.length === 0 && <p className="text-apple-11 text-secondary">No risk–control links for this engagement.</p>}
+      <ul className="space-y-1">
+        {links.map((l) => {
+          const gap = missing.some((m) => m.id === l.id);
+          return (
+            <li key={l.id} className="flex items-center justify-between gap-2 text-apple-12">
+              <span className="text-secondary">
+                {l.isKey && <span className="font-semibold text-primary">Key · </span>}
+                {ctrl(l.controlId)?.code ?? l.controlId} ↔ {riskTitle(l.riskId)}
+                <span className="text-tertiary"> ({l.source})</span>
+              </span>
+              {l.isKey && (gap ? (
+                <button className="text-apple-11 font-semibold text-amber border border-hairline rounded px-2 py-0.5"
+                  onClick={() => { const r = createWorkpaperForGap(l.id, kind); setMsg(r.ok ? null : r.reason ?? 'Failed'); }}>
+                  Create workpaper for gap…
+                </button>
+              ) : <span className="text-apple-11 text-verdigris">Covered</span>)}
+            </li>
+          );
+        })}
+      </ul>
+      {stage === 'planning' && (
+        <button className="text-apple-12 font-semibold text-primary border border-hairline rounded px-3 py-1 bg-surface"
+          onClick={() => { const r = advanceToTesting(engagementId); setMsg(r.ok ? null : r.reason ?? 'Blocked'); }}>
+          Move to Testing
+        </button>
+      )}
+      {msg && <p role="alert" className="text-apple-11 text-amber">{msg}</p>}
+    </div>
+  );
+};
