# Optional local overrides (copy to .env.local if needed).
# Provio core audit engines do not require a cloud AI key.

# APP_URL: Public base URL when deployed (links, callbacks).
# Leave unset for local development.
# APP_URL="http://localhost:3000"

# Supabase project URL (browser + server). One project per environment.
SUPABASE_URL=
# Publishable key. This is the only key the browser may hold.
SUPABASE_PUBLISHABLE_KEY=
# Secret key. Server-side only (migrations, seed script, CI). Never in src/ or dist/.
SUPABASE_SECRET_KEY=
# JWKS URL for verifying session tokens server-side.
SUPABASE_JWKS_URL=

# Unlisted path the Super Admin console answers on (WP9). Default /superadmin.
# Set at deploy time; the path is a deterrent, the role + MFA are the control.
# VITE_PLATFORM_ADMIN_PATH="/ops-console-7f3a"
